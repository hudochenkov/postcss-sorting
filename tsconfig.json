{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node", "jest"]
	},
	"include": ["index.js", "jest-setup.js", "jest-globals.d.ts", "lib/**/*", "benchmark/**/*"],
	"exclude": ["node_modules", "dev", "**/fixtures/**", "benchmark/.cache", "benchmark/results"]
}
